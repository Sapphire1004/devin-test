  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "10.8.3"
  },
  "packageManager": "npm@10.8.3",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
