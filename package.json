    "test:watch": "vitest",
    "qr:fixtures": "node scripts/qr-fixtures.mjs"
  },
  "dependencies": {
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "i18next": "23.16.8",
    "jsqr": "1.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.1.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.30",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "26.1.0",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "typescript": "5.0.4",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
